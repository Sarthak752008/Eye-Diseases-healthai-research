# ==============================================================================
# EyeHealthAI — Git Ignore Rules
# ==============================================================================

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Virtual environments
venv/
.venv/
env/
ENV/

# Environment files & secrets (DO NOT COMMIT SECRETS)
.env
.env.local
.env.*.local
*.pem
*.key

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Jupyter notebook checkpoints
.ipynb_checkpoints/

# Raw Medical Datasets (PROTECT PATIENT DATA PRIVACY & REPO SIZE)
dataset anemia/
Eye Conjunctiva Segmentation Dataset/
Image Dataset on Eye Diseases Classification (Uveitis, Conjunctivitis, Cataract, Eyelid) with Symptoms and SMOTE Validation/
data/processed/

# Large Model Weight Binaries (>100MB exceeds GitHub push limits)
*.pth
*.pt
*.bin
*.onnx
*.h5

# Local temporary test and export files
scratch/
tmp/
*.tmp
temp/
*.db
*.sqlite3
