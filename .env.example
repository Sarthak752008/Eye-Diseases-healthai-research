# ==============================================================================
# EyeHealthAI — Environment Configuration Example (.env.example)
# Rename to .env for local overrides. DO NOT commit production secrets.
# ==============================================================================

# Runtime environment (development / production)
ENV=development
DEBUG=false

# Server network binding
HOST=127.0.0.1
PORT=8000

# CORS Allowed Origins (comma-separated list)
# In production, restrict to your dashboard domain (e.g. https://my-research-domain.org)
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# File upload constraints (in Megabytes)
MAX_UPLOAD_SIZE_MB=10

# Hardware compute device ('cpu' or 'cuda')
DEVICE=cpu

# Optional Custom Model Checkpoint Locations (defaults to workspace saved_models/)
# ANEMIA_CHECKPOINT_PATH=saved_models/anemia/best_model.pth
# CONJUNCTIVITIS_CHECKPOINT_PATH=saved_models/conjunctivitis/best_model_v2_clean.pth
# JAUNDICE_CONFIG_PATH=saved_models/jaundice/jaundice_config.json
